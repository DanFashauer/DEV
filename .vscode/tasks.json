      "problemMatcher": [
        {
          "pattern": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\s*▲\\s+Next\\.js",
            "endsPattern": "^\\s*✓\\s+Ready"
          }
        }
      ]
    },
